# URL final do site, sem barra no fim (usada em canonical, sitemap e og).
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# ID da conta Google Ads (formato AW-XXXXXXXXXX). Vazio = nenhum script do Google é carregado.
NEXT_PUBLIC_GADS_ID=
# Rótulo da conversão "Clique no WhatsApp" criada no Google Ads (Metas > Conversões). Formato: AW-XXXXXXXXXX/abcDEF123
# O site não tem formulário nem ligação: o WhatsApp é o único canal de contato.
NEXT_PUBLIC_GADS_CONV_WHATSAPP=

# 1 só em deploy de revisão: mostra textos ainda não confirmados. Vazio no site oficial.
NEXT_PUBLIC_MOSTRAR_RASCUNHO=
